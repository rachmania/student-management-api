# Normalize all text files to LF in the repository.
# Git auto-detects which files are text vs binary.
* text=auto eol=lf

# --- Windows-specific scripts: must keep CRLF to run correctly ---
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# --- Unix shell scripts & the Maven wrapper: must keep LF ---
*.sh    text eol=lf
mvnw    text eol=lf

# --- Explicitly binary: never convert line endings or diff as text ---
*.jar   binary
*.war   binary
*.class binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.keystore binary
*.p12   binary
*.jks   binary

